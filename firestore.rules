rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read, write: if true;
      
      // Public player docs
      match /players/{playerId} {
        allow read, write: if true;

        // Private player profile (role, stash, brokerInfo, hand, secret ability state)
        match /private/{docId} {
          allow read, write: if true;
        }
      }

      // Private player logs (Whisper campaign alerts, smokescreen feedbacks, personal scheme history)
      match /privateLog/{playerId}/entries/{entryId} {
        allow read, write: if true;
      }

      match /rounds/{roundNumber} {
        allow read, write: if true;
      }

      match /ledger/{roundNumber} {
        allow read, write: if true;
      }

      match /publicLog/{logId} {
        allow read, write: if true;
      }

      // Embezzlement investigation log
      match /embezzlementLog/{logId} {
        allow read, write: if true;
      }

      // Post-game persistent scorecard
      match /scorecard/{playerId} {
        allow read, write: if true;
      }
    }
  }
}

